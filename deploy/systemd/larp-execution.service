[Unit]
Description=LARP execution service (W04 executor; asks the signer host through the database, IDEA-047)
Wants=network-online.target
After=network-online.target time-sync.target
StartLimitIntervalSec=0
# Installed on primary only (deploy/host/provision.sh writes the role marker).
ConditionPathExists=/etc/larp/role-primary
ConditionPathExists=/etc/larp/execution.json

[Service]
Type=simple
User=larp-execution
Group=larp-execution
WorkingDirectory=/opt/larp/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# A permanent release refusal skips startup without entering the automatic restart path.
ExecCondition=/opt/larp/current/.venv/bin/python -m larp.runtime.preflight --manifest /etc/larp/release.json --root /opt/larp/current --profile host --service-config execution=/etc/larp/execution.json
ExecStart=/opt/larp/current/.venv/bin/python -m larp.execution_live.main run --config /etc/larp/execution.json --manifest /etc/larp/release.json --root /opt/larp/current
Restart=always
RestartSec=10
# 2 = not integrated, 3 = run quarantined, 4 = start refused: restarting cures none.
RestartPreventExitStatus=2 3 4
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
MemoryMax=512M
TasksMax=32
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
