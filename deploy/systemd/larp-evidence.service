[Unit]
Description=LARP evidence poller (public filings and registered sources; no trading authority, IDEA-041/047)
Wants=network-online.target
After=network-online.target time-sync.target
StartLimitIntervalSec=0
ConditionPathExists=/etc/larp/role-primary
ConditionPathExists=/etc/larp/evidence.env

[Service]
Type=simple
User=larp-evidence
Group=larp-evidence
WorkingDirectory=/opt/larp/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# Non-secret settings only: LARP_SEC_USER_AGENT and LARP_ARTIFACT_ROOT=/var/lib/larp-evidence. The poller needs no key.
EnvironmentFile=/etc/larp/evidence.env
StateDirectory=larp-evidence
StateDirectoryMode=0700
ExecStartPre=/opt/larp/current/.venv/bin/python -m larp.runtime.preflight --manifest /etc/larp/release.json --root /opt/larp/current --profile host
# Each run covers 24 hours and exits 0; the restart resumes cadence from the poll log (larp/sources/live.py).
ExecStart=/opt/larp/current/.venv/bin/python -m larp.sources.live run --hours 24 --release-manifest /etc/larp/release.json --release-root /opt/larp/current
Restart=always
RestartSec=60
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
MemoryMax=512M
TasksMax=32
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
