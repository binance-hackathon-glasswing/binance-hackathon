[Unit]
Description=LARP runtime (supervised; restarts the same registered build, no manual step)
Wants=network-online.target
After=network-online.target
# No start limit: a crashed agent is always restarted (IDEA-035 C5). Each restart is a journal incident.
StartLimitIntervalSec=0
ConditionPathExists=/etc/larp/runtime.json

[Service]
Type=simple
User=larp-runtime
Group=larp-runtime
WorkingDirectory=/opt/larp/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# The verified release is the registered build; the service refuses any other (never-do #5, F-117).
ExecStartPre=/opt/larp/current/.venv/bin/python -m larp.runtime.preflight --manifest /etc/larp/release.json --root /opt/larp/current
ExecStart=/opt/larp/current/.venv/bin/python -m larp.runtime.service run --config /etc/larp/runtime.json --manifest /etc/larp/release.json --root /opt/larp/current
Restart=always
RestartSec=10
# 2 = not integrated, 3 = run quarantined: restarting cures neither (larp/runtime/service.py).
RestartPreventExitStatus=2 3
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
MemoryMax=1G
TasksMax=64
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
