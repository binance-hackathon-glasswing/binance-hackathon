# Copy to .env and fill in. Never commit .env.

# Binance Web3 Open API (Developer Portal; HMAC-SHA256). The participant kit's demos call these
# BN_WEB3_API_KEY / BN_WEB3_API_SECRET: same values, different names.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ai-seeds decision-log upload (the SDK reads these exact names).
# Address: the dedicated wallet registered with the organisers (one agent per wallet).
# Secret: issued by the organisers for that wallet at registration (64 hex characters).
AI_SEEDS_ADDRESS=
AI_SEEDS_SECRET=

# Private key (or WALLET_MNEMONIC) of the registered wallet: signs transactions locally.
# Not the same as BINANCE_SECRET_KEY. Fill it in only on the one machine that runs the agent
# (one agent per wallet); never commit, print, log or paste it anywhere.
WALLET_PRIVATE_KEY=
