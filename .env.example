# Copy to .env and fill in. Never commit .env.

# Binance Web3 Open API (Developer Portal; HMAC-SHA256). The participant kit's demos call these
# BN_WEB3_API_KEY / BN_WEB3_API_SECRET: same values, different names.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ai-seeds decision-log upload (the SDK reads these exact names; SKILL.md F-92, F-109).
# Address: the dedicated wallet registered with the organisers (one agent per wallet).
# Secret: issued by the organisers for that wallet at registration (64 hex characters).
AI_SEEDS_ADDRESS=
AI_SEEDS_SECRET=
# Optional: overrides the SDK's built-in service URL (default https://api.commonservice.io/ai-seeds-event-log).
# Leave unset for real uploads; only for a test endpoint. manual_push.sh honours it too.
# AI_SEEDS_URL=

# Private key of the registered wallet: signs transactions locally. Not the same as BINANCE_SECRET_KEY.
# Its address MUST equal AI_SEEDS_ADDRESS ("Trade only from the registered AI_SEEDS_ADDRESS"; our code must
# refuse to start otherwise, G-09). Fill it in only on the one machine that runs the agent (one agent per
# wallet); never commit, print, log or paste it anywhere.
WALLET_PRIVATE_KEY=
# Alternative to WALLET_PRIVATE_KEY (the kit's demos accept either): a BIP-39 mnemonic, account derived
# at path m/44'/60'/0'/0/0. Set only one of the two.
# WALLET_MNEMONIC=
