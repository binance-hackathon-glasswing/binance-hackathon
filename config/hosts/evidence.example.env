# /etc/larp/evidence.env on primary (root:root 0644). Non-secret settings for larp-evidence.service only.
# A real contact for SEC fair access; never a placeholder (larp.intelligence.config.sec_user_agent).
LARP_SEC_USER_AGENT=
LARP_ARTIFACT_ROOT=/var/lib/larp-evidence
# Gate A only: set to shadow with a matching manifest-bound dev/shadow runtime.json (IDEA-058).
# Signed/final operation keeps live; unset live parameters still refuse startup.
LARP_EVIDENCE_CONFIG_MODE=live
